# Public application origin. Never place secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk authentication. Keep CLERK_SECRET_KEY server-side only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-your-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Supabase database. Supabase Auth is not used; Clerk remains the auth provider.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Optional server-only Supabase database utility key. Never expose through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
